<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgroGuid.Pages.LoginPage"
    Title="Вхід"
    BackgroundColor="#F2F6F0">

    <Grid ColumnDefinitions="42*,58*">

        <!-- Ліва частина із зображенням -->
        <Grid Grid.Column="0">
            <Image
                Source="agroguid_auth.jpg"
                Aspect="AspectFill"/>

            <BoxView
                BackgroundColor="#174B32"
                Opacity="0.55"/>

            <VerticalStackLayout
                Padding="35"
                Spacing="15"
                VerticalOptions="End">

                <Label
                    Text="🌱 AgroGuid"
                    FontSize="38"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Управляйте своїми полями зручно та ефективно"
                    FontSize="20"
                    TextColor="White"
                    LineBreakMode="WordWrap"/>

                <Label
                    Text="Усі важливі агрономічні інструменти в одному місці"
                    FontSize="13"
                    TextColor="#E3F0E3"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Права частина з формою -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout
                Padding="35,30"
                Spacing="14"
                MaximumWidthRequest="480"
                WidthRequest="480"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Label
                    Text="Вхід до акаунта"
                    FontSize="29"
                    FontAttributes="Bold"
                    TextColor="#243524"/>

                <Label
                    Text="Вітаємо з поверненням до AgroGuid!"
                    FontSize="14"
                    TextColor="#657565"
                    Margin="0,0,0,20"/>

                <Label
                    Text="Логін або електронна пошта"
                    TextColor="#435343"/>

                <Entry
                    x:Name="LoginEntry"
                    Placeholder="Введіть логін або пошту"
                    BackgroundColor="White"
                    TextColor="#243524"
                    PlaceholderColor="#929B92"/>

                <Label
                    Text="Пароль"
                    TextColor="#435343"/>

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Введіть пароль"
                    IsPassword="True"
                    BackgroundColor="White"
                    TextColor="#243524"
                    PlaceholderColor="#929B92"/>

                <Label
                    x:Name="StatusLabel"
                    Text=""
                    TextColor="#B3261E"
                    FontSize="13"/>

                <Button
                    x:Name="LoginButton"
                    Text="Увійти"
                    HeightRequest="50"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnLoginClicked"/>

                <Button
                    Text="Створити новий акаунт"
                    BackgroundColor="Transparent"
                    TextColor="#2E7D32"
                    Clicked="OnRegisterClicked"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
    